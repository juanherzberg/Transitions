  'Since': 'Since the new highway bypassed the town entirely, its once-busy main street fell into a slow decline.',
  'So': 'The lecture hall had grown far too crowded, so the university moved the popular course to the auditorium next door.',
  'Thanks to': 'Thanks to a series of unusually mild winters, the vineyard produced its finest vintages in a decade.',
  'Therefore': 'The experiment could not be replicated by other laboratories; therefore, the journal declined to publish its findings.',
  'Thereby': 'The engineers rerouted the river around the dam, thereby protecting the villages that lay downstream.',
  'Thus': 'The census undercounted the rural population by a wide margin; thus, the districts drawn from it were deeply unequal.',
  'Whereby': 'The two nations established a system whereby disputes over the border would be settled by an independent tribunal.',
  'Fittingly': 'The pioneering aviator had spent her life chasing horizons; fittingly, a distant crater on the moon now bears her name.',
  'Given these facts': 'The soil was exhausted, the rains had failed, and the markets had collapsed; given these facts, the farmers abandoned the region altogether.'
};

const COLOR_CLASS = { blue: 'b-blue', red: 'b-red', purple: 'b-purple', amber: 'b-amber' };
const CAT_NAME = {}; const WORD_HOME = {};
CATEGORIES.forEach(c => { CAT_NAME[c.id] = c.label.split('— ')[1]; c.words.forEach(w => WORD_HOME[w] = c.id); });

// Proper-case category name for the button label (e.g. "Continuity")
function catButtonName(cat) {
  const raw = CAT_NAME[cat.id];
  return raw.charAt(0) + raw.slice(1).toLowerCase();
}

function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
  return a;
}

function highlighted(word, colorHex) {
  const token = HIGHLIGHT[word] || word;
  const sentence = SENTENCES[word] || '';
  // escape regex special chars in token
  const esc = token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const re = new RegExp('(' + esc + ')', 'i');
  if (re.test(sentence)) {
    return sentence.replace(re, '<strong style="color:' + colorHex + '">$1</strong>');
  }
  return sentence;
}

// ---- State ----
let activeIndex = 0;                              // which category is currently active (0–3)
let bucketContents = [[], [], [], []];           // words currently in each bucket (pending, not yet checked)
let completedBuckets = [false, false, false, false];
let poolWords = [];                              // words currently in the pool

// ---- DOM refs ----
const bucketsEl = document.getElementById('buckets');
const poolEl = document.getElementById('pool');
const checkBtn = document.getElementById('checkBtn');
const resetBtn = document.getElementById('resetBtn');

let selected = null;   // tap-to-place selection
let fbOpen = [false, false, false, false]; // collapsed state per bucket

function toggleFbOpen(idx) {
  fbOpen[idx] = !fbOpen[idx];
  render();
}
let dragged = null;    // current drag source chip

// ---- Chip creation ----
function makeChip(word, opts) {
  opts = opts || {};
  const chip = document.createElement('div');
  chip.className = 'chip' + (opts.locked ? ' locked-chip' : '');
  chip.textContent = word;
  chip.dataset.word = word;
  if (!opts.locked) {
    chip.setAttribute('draggable', 'true');
    chip.addEventListener('dragstart', onDragStart);
    chip.addEventListener('dragend', onDragEnd);
    chip.addEventListener('click', onChipClick);
  }
  return chip;
}

// ---- Rendering ----
function bucketIndexById(id) { return CATEGORIES.findIndex(c => c.id === id); }

function render() {
  clearSelection();
  bucketsEl.innerHTML = '';

  CATEGORIES.forEach((cat, idx) => {
    const isCompleted = completedBuckets[idx];
    const isActive = idx === activeIndex && !isCompleted;
    const isLocked = idx > activeIndex && !isCompleted;

    const b = document.createElement('div');
    b.className = 'bucket ' + COLOR_CLASS[cat.color];
    b.dataset.index = idx;
    if (isLocked) b.classList.add('locked');

    // header
    const head = document.createElement('div');
    head.className = 'bucket-head';

    const nameWrap = document.createElement('div');
    nameWrap.className = 'bucket-name';
    nameWrap.innerHTML = cat.label + ' <span class="proto">(' + cat.prototype + ')</span>';
    if (isCompleted) {
      const done = document.createElement('span');
      done.className = 'done-tag';
      done.textContent = '✓ Done';
      nameWrap.appendChild(done);
    }
    head.appendChild(nameWrap);

    // countdown badge
    const remaining = cat.count - bucketContents[idx].length;
    const badge = document.createElement('span');
    badge.className = 'badge';
    if (isCompleted || remaining <= 0) {
      badge.classList.add('full');
      badge.textContent = '✓ Full';
    } else {
      badge.textContent = remaining + ' left';
    }
    head.appendChild(badge);
    b.appendChild(head);

    // description
    const desc = document.createElement('p');
    desc.className = 'bucket-desc';
    desc.textContent = cat.desc;
    b.appendChild(desc);

    if (isLocked) {
      const lock = document.createElement('div');
      lock.className = 'lock-overlay';
      lock.textContent = '🔒 Complete the previous category first';
      b.appendChild(lock);
    } else if (isCompleted) {
      // show inline feedback (locked-in) for the completed bucket
      const fb = document.createElement('div');
      fb.className = 'fb-inline' + (fbOpen[idx] ? ' open' : '');
      fb.innerHTML = buildFeedbackHTML(cat, bucketContents[idx], idx);
      b.appendChild(fb);
    } else {
      // active bucket: interactive dropzone
      const dz = document.createElement('div');
      dz.className = 'dropzone';
      dz.dataset.bucket = cat.id;
      dz.dataset.color = cat.color;
      bucketContents[idx].forEach(w => dz.appendChild(makeChip(w)));
      if (bucketContents[idx].length === 0) dz.classList.add('empty');
      b.appendChild(dz);
      registerDropZone(dz, b);
    }

    bucketsEl.appendChild(b);
  });

  renderPool();
  updateCheckButton();
}

function renderPool() {
  poolEl.innerHTML = '';
  poolWords.forEach(w => poolEl.appendChild(makeChip(w)));
}

// Feedback HTML for a completed bucket (correct chips only remain in bucketContents)
function buildFeedbackHTML(cat, words, idx) {
  const isOpen = fbOpen[idx];
  let sentencesHtml = '';
  words.forEach(word => {
    sentencesHtml += '<div class="fb-item">' +
      '<div class="fb-label ok">✓ ' + word + '</div>' +
      '<div class="fb-sentence">' + highlighted(word, '#16a34a') + '</div>' +
    '</div>';
  });
  return '<div class="fb-summary">' +
    '<span class="fb-summary-count">' + words.length + ' word' + (words.length !== 1 ? 's' : '') + ' correct</span>' +
    '<button class="fb-toggle" onclick="toggleFbOpen(' + idx + ')">' + (isOpen ? 'Hide ▲' : 'Show sentences ▼') + '</button>' +
  '</div>' +
  '<div class="fb-sentences">' + sentencesHtml + '</div>';
}

// ---- Check button state ----
function updateCheckButton() {
  const cat = CATEGORIES[activeIndex];
  if (!cat || completedBuckets[activeIndex] === undefined) return;
  // if everything is done
  const allDone = completedBuckets.every(Boolean);
  if (allDone) {
    checkBtn.textContent = 'All Complete';
    checkBtn.disabled = true;
    return;
  }
  checkBtn.textContent = 'Check ' + catButtonName(cat);
  const remaining = cat.count - bucketContents[activeIndex].length;
  checkBtn.disabled = remaining > 0;
}

// ---- Drag & drop ----
function onDragStart(e) {
  dragged = e.currentTarget;
  dragged.classList.add('dragging');
  clearSelection();
  if (e.dataTransfer) { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', dragged.dataset.word); }
}
function onDragEnd() {
  if (dragged) dragged.classList.remove('dragging');
  dragged = null;
  document.querySelectorAll('.dropzone').forEach(d => d.classList.remove('dragover'));
  document.querySelectorAll('.bucket').forEach(b => b.classList.remove('glow'));
  poolEl.classList.remove('dragover');
}

function registerDropZone(dz, bucket) {
  dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('dragover'); bucket.classList.add('glow'); });
  dz.addEventListener('dragleave', e => { if (!dz.contains(e.relatedTarget)) { dz.classList.remove('dragover'); bucket.classList.remove('glow'); } });
  dz.addEventListener('drop', e => {
    e.preventDefault();
    dz.classList.remove('dragover'); bucket.classList.remove('glow');
    if (dragged) {
      const word = dragged.dataset.word;
      placeInActiveBucket(word);
    }
  });
}

poolEl.addEventListener('dragover', e => { e.preventDefault(); poolEl.classList.add('dragover'); });
poolEl.addEventListener('dragleave', e => { if (!poolEl.contains(e.relatedTarget)) poolEl.classList.remove('dragover'); });
poolEl.addEventListener('drop', e => {
  e.preventDefault();
  poolEl.classList.remove('dragover');
  if (dragged) {
    const word = dragged.dataset.word;
    returnToPool(word);
  }
});

// ---- Move helpers (state-driven) ----
function placeInActiveBucket(word) {
  // only the active bucket accepts chips
  const idx = activeIndex;
  if (completedBuckets[idx]) return;
  // remove from pool if present
  const pi = poolWords.indexOf(word);
  if (pi !== -1) {
    poolWords.splice(pi, 1);
    bucketContents[idx].push(word);
    render();
    return;
  }
  // if the chip is already in the active bucket, nothing changes
}

function returnToPool(word) {
  // remove from the active bucket if present
  const idx = activeIndex;
  if (completedBuckets[idx]) return;
  const bi = bucketContents[idx].indexOf(word);
  if (bi !== -1) {
    bucketContents[idx].splice(bi, 1);
    if (poolWords.indexOf(word) === -1) poolWords.push(word);
    render();
  }
}

// ---- Tap-to-place ----
const previewEl = document.getElementById('preview');
const previewSentenceEl = document.getElementById('preview-sentence');

function showPreview(word) {
  const sentence = SENTENCES[word];
  if (!sentence || !previewEl) return;
  const token = HIGHLIGHT[word] || word;
  const esc = token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const re = new RegExp('(' + esc + ')', 'i');

  let html;
  if (WORD_HOME[word] === 'contrast') {
    // Split sentence at the transition word; color each clause differently
    const match = sentence.match(re);
    if (match) {
      const idx = sentence.search(re);
      const before = sentence.slice(0, idx);
      const after  = sentence.slice(idx + match[0].length);
      html = '<span style="color:#1e40af;font-weight:500">' + before + '</span>' +
             '<strong style="color:#374151;background:#FEF08A;padding:0 3px;border-radius:3px">' + match[0] + '</strong>' +
             '<span style="color:#9a3412;font-weight:500">' + after + '</span>';
    } else {
      html = sentence;
    }
  } else {
    html = sentence.replace(re, '<strong style="color:#1D4ED8">$1</strong>');
  }

  previewSentenceEl.innerHTML = html;
  previewEl.style.display = 'block';
}

function hidePreview() {
  if (previewEl) previewEl.style.display = 'none';
}

function clearSelection() {
  if (selected) { selected.classList.remove('selected'); }
  selected = null;
  hidePreview();
}
function onChipClick(e) {
  e.stopPropagation();
  const chip = e.currentTarget;
  if (selected === chip) { clearSelection(); return; }
  clearSelection();
  selected = chip;
  chip.classList.add('selected');
  showPreview(chip.dataset.word);
}

bucketsEl.addEventListener('click', e => {
  if (!selected) return;
  const dz = e.target.closest('.dropzone');
  if (dz) {
    const bucket = dz.closest('.bucket');
    if (bucket && parseInt(bucket.dataset.index, 10) === activeIndex) {
      const word = selected.dataset.word;
      placeInActiveBucket(word);
    }
  }
});
poolEl.addEventListener('click', e => {
  if (selected && (e.target === poolEl || (e.target.classList && e.target.classList.contains('chip') && poolEl.contains(e.target)))) {
    // only return chips that currently sit in the active bucket
    const word = selected.dataset.word;
    if (bucketContents[activeIndex].indexOf(word) !== -1) {
      returnToPool(word);
    }
  }
});
document.body.addEventListener('click', () => { clearSelection(); });

// ---- Check answers (active bucket only) ----
checkBtn.addEventListener('click', () => {
  const idx = activeIndex;
  if (completedBuckets[idx]) return;
  const cat = CATEGORIES[idx];
  const placed = bucketContents[idx].slice();

  const correct = [];
  const wrong = [];
  placed.forEach(word => {
    if (WORD_HOME[word] === cat.id) correct.push(word);
    else wrong.push(word);
  });

  // Build inline feedback for this bucket (before mutating layout)
  const bucketEl = bucketsEl.querySelector('.bucket[data-index="' + idx + '"]');
  const dz = bucketEl ? bucketEl.querySelector('.dropzone') : null;

  if (dz) {
    let html = '';
    placed.forEach(word => {
      const home = WORD_HOME[word];
      const isCorrect = home === cat.id;
      if (isCorrect) {
        html += '<div class="fb-item">' +
          '<div class="fb-label ok">✓ ' + word + '</div>' +
          '<div class="fb-sentence">' + highlighted(word, '#16a34a') + '</div>' +
        '</div>';
      } else {
        const homeCat = CATEGORIES.find(c => c.id === home);
        const corrWord = homeCat.words.find(w => w !== word) || homeCat.words[0];
        html += '<div class="fb-item">' +
          '<div class="fb-label bad">✗ ' + word + ' — belongs in ' + CAT_NAME[home] + '</div>' +
          '<div class="fb-sentence">' + highlighted(word, '#dc2626') + '</div>' +
          '<div class="fb-correction"><span class="cl">Correct (' + CAT_NAME[home] + '):</span> ' + highlighted(corrWord, '#16a34a') + '</div>' +
        '</div>';
      }
    });
    const correctCount = placed.filter(w => WORD_HOME[w] === cat.id).length;
    const wrongCount = placed.length - correctCount;
    const summaryText = correctCount + ' correct' + (wrongCount > 0 ? ', ' + wrongCount + ' returned to pool' : '');
    const wrappedHtml = '<div class="fb-summary">' +
      '<span class="fb-summary-count">' + summaryText + '</span>' +
      '<button class="fb-toggle" onclick="toggleFbOpen(' + idx + ')">' + (fbOpen[idx] ? 'Hide ▲' : 'Show sentences ▼') + '</button>' +
    '</div><div class="fb-sentences">' + html + '</div>';
    dz.className = 'fb-inline' + (fbOpen[idx] ? ' open' : '');
    dz.innerHTML = wrappedHtml;
  }

  // Only correct chips remain in the (now completed) bucket
  bucketContents[idx] = correct;

  // Wrong chips return to the pool (append to end)
  wrong.forEach(word => { if (poolWords.indexOf(word) === -1) poolWords.push(word); });
  renderPool();

  // If any chips were wrong, the bucket is NOT complete — the learner must fix them.
  if (wrong.length > 0) {
    // re-render so the dropzone becomes interactive again, keeping correct chips in place
    render();
    // scroll the active bucket into view
    const el = bucketsEl.querySelector('.bucket[data-index="' + idx + '"]');
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    return;
  }

  // All correct — mark complete, add Done tag, lock chips, unlock next
  completedBuckets[idx] = true;

  if (bucketEl) {
    // add Done tag to header
    const nameWrap = bucketEl.querySelector('.bucket-name');
    if (nameWrap && !nameWrap.querySelector('.done-tag')) {
      const done = document.createElement('span');
      done.className = 'done-tag';
      done.textContent = '✓ Done';
      nameWrap.appendChild(done);
    }
    // update badge to Full
    const badge = bucketEl.querySelector('.badge');
    if (badge) { badge.classList.add('full'); badge.textContent = '✓ Full'; }
  }

  // Advance active index to next incomplete bucket
  const nextIndex = idx + 1;
  if (nextIndex < CATEGORIES.length) {
    activeIndex = nextIndex;
    render();
    // flash the newly unlocked bucket
    const nextEl = bucketsEl.querySelector('.bucket[data-index="' + nextIndex + '"]');
    if (nextEl) {
      nextEl.classList.add('just-unlocked');
      setTimeout(() => nextEl.classList.remove('just-unlocked'), 1000);
      nextEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  } else {
    // all done
    activeIndex = CATEGORIES.length - 1;
    render();
  }
});

// ---- Reset ----
resetBtn.addEventListener('click', () => {
  initState();
  render();
});

function initState() {
  activeIndex = 0;
  bucketContents = [[], [], [], []];
  completedBuckets = [false, false, false, false];
  fbOpen = [false, false, false, false];
  const all = [];
  CATEGORIES.forEach(c => c.words.forEach(w => all.push(w)));
  poolWords = shuffle(all);
}

// ---- Init ----
initState();
render();
</script>
</body>
</html>
